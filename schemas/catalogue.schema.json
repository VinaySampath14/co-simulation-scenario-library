{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "scenario": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^SCN-[0-9]{4}$"},
        "title": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "record_type": {"enum": ["software_demo", "research_benchmark", "laboratory_validation", "research_testbed", "research_scenario"]},
        "framework": {"anyOf": [{"type": "string", "minLength": 1, "pattern": "\\S"}, {"type": "null"}]},
        "framework_software_id": {"type": "string", "pattern": "^SW-[0-9]{4}$"},
        "framework_software_ids": {"type": "array", "items": {"type": "string", "pattern": "^SW-[0-9]{4}$"}, "minItems": 1},
        "domain": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}, "minItems": 1},
        "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[0-9]{4}$"}, "minItems": 1},
        "scientific_publication_id": {"anyOf": [{"type": "string", "pattern": "^PUB-[0-9]{4}$"}, {"type": "null"}]},
        "related_publication_ids": {"type": "array", "items": {"type": "string", "pattern": "^PUB-[0-9]{4}$"}, "minItems": 0},
        "related_scenario_ids": {"type": "array", "items": {"type": "string", "pattern": "^SCN-[0-9]{4}$"}, "minItems": 0},
        "research_objective": {"anyOf": [{"type": "string", "minLength": 1, "pattern": "\\S"}, {"type": "null"}]},
        "technical_purpose": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "collection_status": {"enum": ["draft", "catalogued"]},
        "verification_status": {"enum": ["not_yet_investigated", "publication_review", "static_source_review", "mixed_source_review"]},
        "runtime_verification_status": {"enum": ["not_run", "run_unverified", "reproduced", "reproduction_failed"]},
        "code_url": {"anyOf": [{"type": "string", "pattern": "^https?://[^\\s]+$"}, {"type": "null"}]},
        "code_revision": {"anyOf": [{"type": "string", "pattern": "^[a-fA-F0-9]{40}([a-fA-F0-9]{24})?$"}, {"type": "null"}]},
        "entry_point": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "configuration": {"type": "object"},
        "outputs": {"type": "array", "items": {"type": "object"}, "minItems": 0},
        "live_demo": {"type": "object"},
        "locked_software": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"software_id": {"type": "string", "pattern": "^SW-[0-9]{4}$"}, "version": {"type": "string", "minLength": 1, "pattern": "\\S"}},
            "required": ["software_id", "version"],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[0-9]{4}$"}, "minItems": 1},
        "review_status": {"enum": ["draft", "structurally_validated", "evidence_checked", "human_reviewed", "accepted"]},
        "human_review": {
          "type": "object",
          "properties": {
            "reviewer": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "note": {"type": "string", "minLength": 1, "pattern": "\\S"}
          },
          "required": ["reviewer", "date", "note"],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "title",
        "record_type",
        "framework",
        "domain",
        "source_ids",
        "scientific_publication_id",
        "research_objective",
        "collection_status",
        "verification_status",
        "runtime_verification_status",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"record_type": {"const": "software_demo"}}},
          "then": {
            "anyOf": [
              {"required": ["technical_purpose"]},
              {"properties": {"research_objective": {"type": "string", "minLength": 1, "pattern": "\\S"}}}
            ]
          },
          "else": {"properties": {"scientific_publication_id": {"type": "string", "pattern": "^PUB-[0-9]{4}$"}}}
        },
        {
          "if": {"required": ["review_status"], "properties": {"review_status": {"enum": ["human_reviewed", "accepted"]}}},
          "then": {"required": ["human_review"]}
        }
      ]
    },
    "participations": {
      "type": "object",
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^SCN-[0-9]{4}$"},
        "note": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "participations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^PART-[0-9]{4}$"},
              "reported_component": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "model_id": {"anyOf": [{"type": "string", "pattern": "^MOD-[0-9]{4}$"}, {"type": "null"}]},
              "software_id": {"anyOf": [{"type": "string", "pattern": "^SW-[0-9]{4}$"}, {"type": "null"}]},
              "role": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "identification_status": {"type": "string", "pattern": "^(?:identified(?:_[a-z_]+)?|unresolved_[a-z_]+|output_component|physical_hardware)$"},
              "configuration": {"type": "object"},
              "dependency_software_ids": {"type": "array", "items": {"type": "string", "pattern": "^SW-[0-9]{4}$"}, "minItems": 0},
              "simulator": {"type": "object"},
              "entities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {"type": {"type": "string", "minLength": 1, "pattern": "\\S"}, "count": {"type": "integer", "minimum": 1}},
                  "required": ["type", "count"],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[0-9]{4}$"}, "minItems": 1}
            },
            "required": ["id", "reported_component", "model_id", "software_id", "role", "identification_status", "evidence_ids"],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": ["scenario_id", "participations"],
      "additionalProperties": false
    },
    "interactions": {
      "type": "object",
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^SCN-[0-9]{4}$"},
        "review_status": {"enum": ["not_yet_investigated", "publication_review", "explicitly_reported", "verified_from_code", "mixed_evidence"]},
        "note": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "interactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^INT-[0-9]{4}$"},
              "interaction_type": {"enum": ["simulation_coupling", "result_recording", "visualization", null]},
              "source_participation_id": {"type": "string", "pattern": "^PART-[0-9]{4}$"},
              "target_participation_id": {"type": "string", "pattern": "^PART-[0-9]{4}$"},
              "attributes": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source": {"type": "string", "minLength": 1, "pattern": "\\S"},
                        "target": {"type": "string", "minLength": 1, "pattern": "\\S"},
                        "unit": {"anyOf": [{"type": "string", "minLength": 1, "pattern": "\\S"}, {"type": "null"}]}
                      },
                      "required": ["source", "target"],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  {"type": "null"}
                ]
              },
              "reported_quantities": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}, "minItems": 1},
              "source_entity_types": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}, "minItems": 1},
              "target_entity_types": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}, "minItems": 1},
              "note": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "applies_to": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[0-9]{4}$"}, "minItems": 1}
            },
            "required": ["id", "interaction_type", "source_participation_id", "target_participation_id", "attributes", "evidence_ids"],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": ["scenario_id", "review_status", "interactions"],
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^MOD-[0-9]{4}$"},
        "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "model_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "definition": {
          "type": "object",
          "properties": {
            "source_id": {"type": "string", "pattern": "^SRC-[0-9]{4}$"},
            "locator": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "path": {"type": "string", "minLength": 1, "pattern": "\\S"}
          },
          "required": ["source_id"],
          "additionalProperties": false,
          "anyOf": [{"required": ["locator"]}, {"required": ["path"]}]
        },
        "representation": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "scope": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[0-9]{4}$"}, "minItems": 1}
      },
      "required": ["id", "name", "model_type", "definition", "representation", "evidence_ids"],
      "additionalProperties": false
    },
    "publications": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^PUB-[0-9]{4}$"},
        "title": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "authors": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}, "minItems": 1},
        "year": {"type": "integer", "minimum": 1800},
        "type": {"enum": ["masters_thesis", "doctoral_thesis", "conference_paper", "journal_article", "technical_report"]},
        "source_id": {"type": "string", "pattern": "^SRC-[0-9]{4}$"},
        "doi": {"anyOf": [{"type": "string", "minLength": 1, "pattern": "\\S"}, {"type": "null"}]},
        "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[0-9]{4}$"}, "minItems": 1},
        "institution": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "conference": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "paper_number": {"type": ["integer", "string"]},
        "pages": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "journal": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "volume": {"type": ["integer", "string"]},
        "issue": {"type": ["integer", "string"]},
        "article_number": {"type": ["integer", "string"]}
      },
      "required": ["id", "title", "authors", "year", "type", "source_id", "doi", "evidence_ids"],
      "additionalProperties": false
    },
    "software": {
      "type": "object",
      "properties": {
        "software": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^SW-[0-9]{4}$"},
              "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "type": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
              "url": {"type": "string", "pattern": "^https?://[^\\s]+$"}
            },
            "required": ["id", "name", "type"],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": ["software"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^SRC-[0-9]{4}$"},
              "type": {
                "enum": [
                  "source_repository",
                  "source_archive",
                  "official_website",
                  "package_release",
                  "masters_thesis",
                  "official_documentation",
                  "journal_or_conference_publication",
                  "conference_publication",
                  "journal_publication",
                  "dataset",
                  "technical_report"
                ]
              },
              "url": {"type": "string", "pattern": "^(?:https?://[^\\s]+|urn:sha256:[a-f0-9]{64})$"},
              "title": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "version_or_commit": {"anyOf": [{"type": "string", "minLength": 1, "pattern": "\\S"}, {"type": "null"}]},
              "note": {"type": "string", "minLength": 1, "pattern": "\\S"}
            },
            "required": ["id", "type", "url", "title"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^EVD-[0-9]{4}$"},
              "scenario_id": {"type": "string", "pattern": "^SCN-[0-9]{4}$"},
              "subject": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "source_id": {"type": "string", "pattern": "^SRC-[0-9]{4}$"},
              "locator": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "evidence_status": {
                "enum": ["explicitly_reported", "verified_from_code", "inferred", "unknown", "not_reported", "not_yet_investigated", "conflicting"]
              },
              "note": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "locator_url": {"type": "string", "pattern": "^https?://[^\\s]+$"},
              "file_path": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1}
            },
            "required": ["id", "scenario_id", "subject", "source_id", "locator", "evidence_status"],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": ["sources", "assertions"],
      "additionalProperties": false
    }
  }
}
